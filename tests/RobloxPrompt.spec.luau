return function(Prompt)
    local pg=Instance.new("Folder")
    local data={productName="Reference item - Gift",icon="rbxasset://textures/ui/common/robux@3x.png",
        balance=10000,price=3500,cost=3150,discountLabel="Saving 350 with Plus",resultText="Local test completed."}
    local buys,cancels=0,0
    local view=Prompt.open(pg,data,false,function()buys+=1 end,function()cancels+=1 end)
    local ok,err=pcall(function()
        local gui=view.gui
        local panel=gui.Shade.Dialog
        assert(panel.Title.Text=="Buy item","Affordable local checkout uses the ordinary purchase heading")
        assert(not panel:FindFirstChild("PriceSummary"),"No standalone Total card in the purchase dialog")
        assert(panel.Product.Position==UDim2.fromOffset(100,64)and panel.Product.Size==UDim2.fromOffset(336,32))
        assert(panel.Price.Position==UDim2.fromOffset(123,92)and panel.PriceIcon.Position==UDim2.fromOffset(100,97))
        assert(panel.PriceIcon.Size==UDim2.fromOffset(18,18))
        assert(gui.ScreenInsets==Enum.ScreenInsets.DeviceSafeInsets,"Match native prompt screen coordinates")
        assert(panel.Close.Text=="" and panel.Close.Icon.Text=="x","Close uses the BuilderIcons X")
        assert(panel.Close.Icon.FontFace.Family=="rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json")
        assert(panel.Close.Icon.Size==UDim2.fromOffset(24,24))
        assert(panel.Buy.Caption.TextSize==18 and panel.OriginalPrice.TextSize==15,"Reference typography sizes")
        assert(not panel:FindFirstChild("Scope") and not panel:FindFirstChild("SimulationMode"))
        assert(panel.Terms.Text:gsub("<[^>]+>","")=="Your payment method will be charged. Roblox Terms of Use apply.")
        assert(panel.Terms.Text=="Your payment method will be charged. Roblox <u>Terms of Use</u> apply.","Only Terms of Use is underlined")
        assert(not gui:GetAttribute("DiscountExpanded"))
        assert(view:toggleDiscount() and gui:GetAttribute("DiscountExpanded"))
        assert(panel.DiscountArrow.Text=="chevron-small-up" and panel.DiscountIcon.Text=="roblox-plus")
        assert(panel.DiscountSubtotal.Text=="Subtotal" and panel.DiscountSubtotalAmount.Text=="3,500")
        assert(panel.DiscountSavingsAmount.Text=="- 350" and panel.DiscountTotalAmount.Text=="3,150")
        assert(panel.Size.Y.Offset==456 and panel.DiscountTotal.Visible and buys==0)
        assert(panel.Buy.Position.Y.Offset==370 and panel.Terms.Position.Y.Offset==417)
        assert(view:toggleDiscount() and not gui:GetAttribute("DiscountExpanded"))
        assert(panel.Size.Y.Offset==344 and not panel.DiscountTotal.Visible)
        assert(panel.Buy.Position.Y.Offset==258 and panel.Terms.Position.Y.Offset==305)
        assert(gui:GetAttribute("Simulation") and gui:GetAttribute("Renderer")=="LocalRobloxPrompt")
        local reduced=gui:GetAttribute("ReducedMotion")
        assert(panel.GroupTransparency==(reduced and 0 or 1) and panel.Position.Y.Offset==(reduced and 0 or 32))
        assert(not view:activate() and buys==0,"Opening cannot confirm")
        view:step(.15)
        if reduced then assert(panel.GroupTransparency==0 and panel.Position.Y.Offset==0)
        else assert(panel.GroupTransparency>0 and panel.GroupTransparency<1 and panel.Position.Y.Offset>0)end
        assert(gui:GetAttribute("BuyProgress")==0 and not view:activate())
        view:step(.15)
        assert(panel.GroupTransparency==0 and panel.Position.Y.Offset==0)
        assert(gui:GetAttribute("BuyProgress")==0 and not view:ready())
        view:step(1.25)
        assert(math.abs(gui:GetAttribute("BuyProgress")-.25)<.0001,"Otter's Quad advances to one-quarter at half time")
        assert(not view:activate() and buys==0)
        view:step(1.25)
        assert(view:ready() and gui:GetAttribute("BuyReady"))
        assert(view:activate() and buys==1)
        assert(not view:activate() and buys==1,"One view submits once")
        view:close(true)
        if not reduced then
            assert(gui.Parent and not view:activate())
            view:step(.05)
            assert(panel.GroupTransparency>0 and panel.Position.Y.Offset>0)
            view:step(.05)
        end
        assert(not gui.Parent,"Close animation removes the view")
        view=Prompt.open(pg,data,true,function()error("Completion cannot buy")end,function()cancels+=1 end)
        local completed=view.gui.Shade.Dialog
        assert(not completed:FindFirstChild("SimulationMode"),"Completion has no Local Simulation caption")
        assert(completed.Size==UDim2.fromOffset(456,236),"Completion follows the reference's compact aspect ratio")
        assert(completed.Check.Position==UDim2.fromOffset(204,64)and completed.Check.Size==UDim2.fromOffset(48,48))
        assert(completed.Check.Text=="circle-check" and completed.Check.FontFace.Family=="rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json","Reuse the installed Roblox completion glyph")
        assert(completed.Result.Position==UDim2.fromOffset(20,124)and completed.Result.Size==UDim2.fromOffset(416,32))
        assert(completed.OK.Position.Y.Offset==176)
        assert(not view.gui.Shade.Dialog:FindFirstChild("Terms") and not view.gui.Shade.Dialog:FindFirstChild("Scope"))
        assert(not view:toggleDiscount(),"Completion has no discount accordion")
        assert(not view:activate(),"Completion has the initial input lock too")
        view:step(.3)
        assert(view:activate() and cancels==1)
        assert(not view:activate() and cancels==1)
        view:close()
        local regular=table.clone(data);regular.discountLabel=nil;regular.cost=regular.price
        view=Prompt.open(pg,regular,false,function()end,function()end)
        assert(view.gui.Shade.Dialog.Title.Text=="Buy item")
        assert(view.gui.Shade.Dialog.Size.Y.Offset==264 and view.gui.Shade.Dialog.Buy.Position.Y.Offset==178)
        assert(view.gui.Shade.Dialog.Terms.Position.Y.Offset==225)
        assert(not view.gui.Shade.Dialog:FindFirstChild("PriceSummary")and not view.gui.Shade.Dialog:FindFirstChild("DiscountRow"))
        view:close()
        local invalid=table.clone(data);invalid.cost=0/0
        assert(not pcall(Prompt.open,pg,invalid,false,function()end,function()end))
        assert(not pg:FindFirstChild("BloxCatalogCheckout"),"Invalid data cannot leave a modal")
    end)
    view:close();pg:Destroy();assert(ok,err)
    return "Roblox prompt assertions passed: source-timed entry, delayed Quad fill, single activation, animated exit and completion guard"
end

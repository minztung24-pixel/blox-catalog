</ProtectedString></Properties></Item></Item><Item class="ModuleScript"><Properties><string name="Name">Catalog</string><ProtectedString name="Source">local Database = require(script.Parent.Data)
local Catalog = {byId = {}, byToolName = {}, count = 0, databases = Database, categories = {"Fruits", "Permanent", "Fruit Skins", "Premium", "Swords", "Guns", "Skills"}}
local function toolName(name, id)
    local previous = Catalog.byToolName[name]
    if previous == nil then Catalog.byToolName[name] = id
    elseif previous ~= id then Catalog.byToolName[name] = false end
end
for _, category in ipairs(Catalog.categories) do
    for _, item in ipairs(Database[category]) do
        assert(not Catalog.byId[item.id], "Duplicate catalog ID")
        Catalog.byId[item.id] = item
        Catalog.count += 1
        if item.idType == "PhysicalMoveset" then
            toolName(item.storageKey .. " Fruit", item.id)
            toolName(item.name .. " Fruit", item.id)
        elseif item.idType == "Moveset" then
            toolName(item.storageKey, item.id); toolName(item.name, item.id)
        end
    end
end
function Catalog.matches(item, query)
    local text = table.concat({item.name, item.id, item.rarity, item.title, item.storageKey}, " "):lower()
    query = query:match("^%s*(.-)%s*$"):lower()
    return text:find(query, 1, true) ~= nil
end
function Catalog.search(query, category)
    local result = {}
    for _, item in ipairs(Database[category] or {}) do
        if Catalog.matches(item, query) then table.insert(result, item) end
    end
    return result
end
return Catalog
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">NativeItems</string><ProtectedString name="Source">local NativeItems = {}

function NativeItems.new(service, remote, Future, Result, equipActions, onEquip, hook)
    assert(service.IS_CLIENT == true and service.IsInitialized == true, "Item cache is not initialized")
    assert(typeof(service.ReadItem) == "function" and typeof(service.WriteTempItem) == "function", "Item cache API unavailable")
    assert(typeof(Future.from) == "function" and typeof(Result.ok) == "function" and typeof(Result.err) == "function", "Native action result API unavailable")
    assert(typeof(remote.invokeAction) == "function" and (hook or not table.isfrozen(remote)), "Native actions cannot be guarded")
    local verified = 0
    for _, row in ipairs(service:GetItems()) do
        if typeof(row) == "table" and (typeof(row.Value) == "number" or typeof(row.Value) == "boolean") then
            local ok, value = pcall(service.ReadItem, service, row.Key, row.ItemId, row.NetworkedUID)
            if ok and value == row.Value then verified += 1 end
            if verified &gt;= 2 then break end
        end
    end
    assert(verified &gt;= 2, "Native read signature could not be verified")
    local keys = assert(service.KEYS, "Native item keys unavailable")
    local quantityKey = assert(keys.QUANTITY, "Native quantity key unavailable")
    local bridge = {entries = {}}
    local function read(id) return service:ReadItem(quantityKey, id, nil) end
    local function scalar(value)
        local kind = typeof(value)
        if kind == "number" or kind == "string" or kind == "boolean" or kind == "nil" then return tostring(value):sub(1, 120) end
        return "&lt;" .. kind .. "&gt;"
    end
    local function write(id, value, attempt)
        -- UserReplicationCache.Set stores zero and false as nil before notifying listeners.
        if value == 0 or value == false then value = nil end
        local returned = service:WriteTempItem(quantityKey, id, nil, value)
        local actual = read(id)
        if attempt then attempt.after = actual; attempt.observed = true end
        if actual ~= value then
            bridge.lastFailure = {itemId = id, key = tostring(quantityKey), expected = scalar(value), expectedType = typeof(value),
                actual = scalar(actual), actualType = typeof(actual), returnedType = typeof(returned)}
            error("Native write verification failed: " .. tostring(quantityKey) .. " / ID " .. id
                .. " / expected " .. scalar(value) .. " / actual " .. scalar(actual), 0)
        end
    end
    function bridge:sync(item, count, outsideStock)
        self.lastFailure = nil
        local id = tonumber(item.id)
        if not id then return false, "Invalid ItemId" end
        local entry = self.entries[id] or {item = item}
        local attempt = {}
        local desired
        local ok, err = pcall(function()
            local current = read(id)
            if not self.entries[id] or current ~= entry.written then entry.original = current end
            local originalQuantity = entry.original or 0
            assert(typeof(originalQuantity) == "number" and originalQuantity == originalQuantity
                and originalQuantity &gt;= 0 and originalQuantity &lt; math.huge and originalQuantity % 1 == 0, "Invalid native quantity")
            assert(typeof(count) == "number" and count &gt;= 0 and count &lt; math.huge and count % 1 == 0, "Invalid local quantity")
            local stock = math.max(0, count - (outsideStock and 1 or 0))
            assert(originalQuantity + stock &lt;= 9007199254740991, "Native quantity limit reached")
            desired = originalQuantity + stock
            if desired == 0 then desired = nil end
            attempt.before = current
            attempt.started = true
            write(id, desired, attempt)
        end)
        if not ok then
            local failure = self.lastFailure
            if attempt.started and not attempt.observed then
                local readable, current = pcall(read, id)
                if readable and current == desired then attempt.after = current; attempt.observed = true end
            end
            if attempt.observed and attempt.after ~= attempt.before then
                local restored = pcall(function()
                    if read(id) == attempt.after then write(id, attempt.before) end
                end)
                if not restored then entry.written = attempt.after; self.entries[id] = entry end
            end
            self.lastFailure = failure
            return false, tostring(err)
        end
        entry.item = item; entry.written = desired
        self.entries[id] = entry
        return true
    end
    function bridge:restore(item)
        local id = tonumber(item.id)
        local entry = self.entries[id]
        if not entry then return true end
        local ok, err = pcall(function()
            -- Keep a replication update that superseded this script's local value.
            if read(id) == entry.written then write(id, entry.original) end
        end)
        if not ok then return false, tostring(err) end
        self.entries[id] = nil
        return true
    end
    local target, original = remote.invokeAction, remote.invokeAction
    local handler = function(action, id, uid, equipped)
        local entry = bridge.entries[id]
        if not entry or uid ~= nil then return original(action, id, uid, equipped) end
        if equipActions[action] and typeof(entry.original) == "number" and entry.original &gt; 0 then
            return original(action, id, uid, equipped)
        end
        -- RemoteUtil returns Future&lt;Result&gt;; synthetic actions stay entirely local.
        return Future.from(function()
            if equipActions[action] then
                local called, ok, err = pcall(onEquip, entry.item)
                if called and ok then return Result.ok() end
                return Result.err(tostring(called and err or ok))
            end
            return Result.err("Simulated item: clear local copies before using native transactions")
        end)
    end
    if hook then original = hook(target, handler); assert(typeof(original) == "function", "Action hook failed")
    else remote.invokeAction = handler end
    function bridge:close()
        local items = {}
        for _, entry in pairs(self.entries) do table.insert(items, entry.item) end
        for _, item in ipairs(items) do
            local ok, err = self:restore(item)
            if not ok then return false, err end
        end
        local ok, err = pcall(function()
            if hook then hook(target, original)
            elseif remote.invokeAction == handler then remote.invokeAction = original end
        end)
        return ok, err
    end
    return bridge
end

function NativeItems.connect(onEquip)
    assert(typeof(getloadedmodules) == "function", "Open Items in Blox Fruits, then press Rescan")
    local loaded = {}
    for _, module in pairs(getloadedmodules()) do loaded[module] = true end
    local storage = game:GetService("ReplicatedStorage")
    local function cached(path)
        local module = storage
        for name in path:gmatch("[^.]+") do module = module and module:FindFirstChild(name) end
        assert(module and module:IsA("ModuleScript") and loaded[module], "Open Items, then Rescan: " .. path .. " not cached")
        local result
        local worker = task.spawn(function() result = table.pack(pcall(require, module)) end)
        local deadline = os.clock() + 3
        while not result and os.clock() &lt; deadline do task.wait(0.03) end
        if not result then pcall(task.cancel, worker); error("Cached module timed out: " .. path) end
        assert(result[1], result[2])
        return result[2]
    end
    local service = cached("ItemReplicationService")
    local remote = cached("Controllers.UI.Inventory.RemoteUtil")
    local Future, Result, enums = cached("Packages.Future"), cached("Packages.Result"), cached("PseudoEnum")
    local actions = {}
    actions[assert(enums.InventoryAction.EquipFruit)] = true
    actions[assert(enums.InventoryAction.EquipItem)] = true
    local hook = typeof(hookfunction) == "function" and hookfunction or nil
    return NativeItems.new(service, remote, Future, Result, actions, onEquip, hook)
end

return NativeItems
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">NativeEquip</string><ProtectedString name="Source">local NativeEquip = {}

function NativeEquip.new(playerGui,state,onEquip)
    local binding = {}
    local overlay, original, connection
    local function normalized(text)
        return text:gsub("&lt;[^&gt;]*&gt;",""):gsub("%s+"," "):match("^%s*(.-)%s*$"):lower()
    end
    local function selected()
        local main=playerGui:FindFirstChild("Main")
        local inventory=main and main:FindFirstChild("InventoryContainer")
        local left=inventory and inventory:FindFirstChild("Left")
        local label=left and left:FindFirstChild("ItemName")
        local button=left and left:FindFirstChild("Equip")
        if not label or not label:IsA("TextLabel") or not button or not button:IsA("GuiButton") then return nil end
        local name=normalized(label.Text)
        local match
        for _,row in pairs(state.items) do
            local entry=state.native and state.native.entries[tonumber(row.item.id)]
            if row.item.category=="Fruits" and entry and not (typeof(entry.original)=="number" and entry.original&gt;0)
                and normalized(row.item.name)==name then
                if match then return nil end
                match=row.item
            end
        end
        return match,button
    end
    local function clear()
        if connection then connection:Disconnect();connection=nil end
        if overlay then overlay:Destroy();overlay=nil end
        original=nil
    end
    function binding:refresh()
        if self.closed then return end
        local item,button=selected()
        if not item then clear();return end
        if original~=button or not overlay or not overlay.Parent then
            clear()
            original=button
            -- Only simulated fruit selections cover the legacy callback; real selections keep the original button.
            overlay=Instance.new("TextButton")
            overlay.Name="BloxCatalogEquip"
            overlay.Text=""
            overlay.BackgroundTransparency=1
            overlay.AutoButtonColor=false
            overlay:SetAttribute("LocalSimulation",true)
            overlay.Parent=button.Parent
            connection=overlay.Activated:Connect(function()
                local current,currentButton=selected()
                if current and currentButton==original then onEquip(current) end
            end)
        end
        overlay.AnchorPoint=button.AnchorPoint
        overlay.Position=button.Position
        overlay.Size=button.Size
        overlay.Rotation=button.Rotation
        overlay.ZIndex=button.ZIndex+1
        overlay.Visible=button.Visible
        overlay.Selectable=button.Selectable
    end
    function binding:close()
        self.closed=true
        clear()
    end
    return binding
end

return NativeEquip
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">NativeDialogue</string><ProtectedString name="Source">local NativeDialogue = {}

function NativeDialogue.new(controller)
    assert(typeof(controller)=="table","Native dialogue controller is unavailable")
    for _,name in ipairs({"new","start","getActiveDialogue","close"}) do
        assert(typeof(controller[name])=="function","Native dialogue API unavailable: "..name)
    end
    local binding = {controller=controller,running=false,closed=false}
    function binding:dismiss()
        if not self.dialogue then return end
        local ok,active=pcall(controller.getActiveDialogue)
        -- Never close an NPC or genuine fruit dialogue opened by somebody else.
        if ok and active and active._dialogue==self.dialogue then pcall(controller.close) end
    end
    function binding:show(tool,actions)
        if self.closed then return false,"Native fruit menu is closed" end
        if self.running or controller.getActiveDialogue() then return false,"Finish the current game dialogue first" end
        if not tool:GetAttribute("BloxCatalogOwned") then return false,"Use the original menu for real fruit" end
        self.running=true
        local selected
        local connections={}
        local ok,message=pcall(function()
            local dialogue=controller.new()
            self.dialogue=dialogue
            dialogue:setTitle("Blox Fruit")
            dialogue:addPage(function(page)
                page:addText("What do you wish to do with this Blox Fruit?&lt;AnimateYield=3&gt;")
                for _,name in ipairs({"Eat","Drop","Store"}) do
                    page:addOption(function(option)
                        option:setText(name)
                        option:setType("Chat")
                        option:onSelected(function()selected=name end)
                    end)
                end
                page:setCancelText("Nevermind")
            end)
            dialogue:build()
            -- startForTool lazily requires another game module, which fails in the executor context.
            local function dismissOwned()
                if self.dialogue==dialogue then self:dismiss() end
            end
            table.insert(connections,tool.Unequipped:Connect(dismissOwned))
            table.insert(connections,tool.Destroying:Connect(dismissOwned))
            controller.start(dialogue)
        end)
        for _,connection in ipairs(connections) do connection:Disconnect() end
        if not ok then self:dismiss() end
        self.running=false
        self.dialogue=nil
        if not ok then return false,tostring(message) end
        if self.closed then return false,"Native fruit menu was closed" end
        if selected and actions[selected] then
            local called,err=pcall(actions[selected])
            if not called then return false,tostring(err) end
        end
        return true
    end
    function binding:close()
        self.closed=true
        self:dismiss()
    end
    return binding
end

function NativeDialogue.connect()
    assert(typeof(getloadedmodules)=="function","Open a game dialogue once, then retry")
    local module=game:GetService("ReplicatedStorage"):FindFirstChild("DialogueController")
    assert(module and module:IsA("ModuleScript"),"Game dialogue controller is unavailable")
    local loaded=false
    for _,candidate in pairs(getloadedmodules()) do if candidate==module then loaded=true;break end end
    assert(loaded,"Open a game dialogue once, then retry")
    local result
    local worker=task.spawn(function()result=table.pack(pcall(require,module))end)
    local deadline=os.clock()+3
    while not result and os.clock()&lt;deadline do task.wait(0.03) end
    if not result then pcall(task.cancel,worker);error("Cached dialogue controller timed out") end
    assert(result[1],result[2])
    return NativeDialogue.new(result[2])
end

return NativeDialogue
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Equipment</string><ProtectedString name="Source">local Equipment = {}

function Equipment.findExistingTool(player, item)
    local function normalized(name) return name:lower():gsub("%s", "") end
    local names = {}
    local suffix = item.category == "Fruits" and " Fruit" or ""
    names[normalized(item.name .. suffix)] = true
    names[normalized((item.storageKey or item.name) .. suffix)] = true
    local fallback
    for _, root in pairs({player:FindFirstChildOfClass("Backpack"), player.Character}) do
        for _, tool in ipairs(root:GetChildren()) do
            if tool:IsA("Tool") and not tool:GetAttribute("BloxCatalogOwned") and not tool:GetAttribute("ClientCatalogOwned") then
                local id = tool:GetAttribute("ItemId")
                if id ~= nil then
                    if tostring(id) == item.id then return tool end
                elseif names[normalized(tool.Name)] then fallback = fallback or tool end
            end
        end
    end
    return fallback
end

function Equipment.clone(source, item)
    if not source or not source.Parent or source:IsA("LuaSourceContainer") then return nil end
    local ok, clone = pcall(function() return source:Clone() end)
    if not ok or not clone then return nil end
    local CollectionService = game:GetService("CollectionService")
    local function clearTags(node)
        for _, tag in ipairs(CollectionService:GetTags(node)) do CollectionService:RemoveTag(node, tag) end
    end
    clearTags(clone)
    for _, node in ipairs(clone:GetDescendants()) do
        clearTags(node)
        if node:IsA("LuaSourceContainer") or node:IsA("RemoteEvent") or node:IsA("RemoteFunction")
            or node:IsA("ProximityPrompt") or node:IsA("ClickDetector") or node:IsA("BodyMover") or node:IsA("Sound") then
            node:Destroy()
        elseif node:IsA("JointInstance") or node:IsA("WeldConstraint") or node:IsA("NoCollisionConstraint") then
            if not node.Part0 or not node.Part1 or not node.Part0:IsDescendantOf(clone) or not node.Part1:IsDescendantOf(clone) then node:Destroy() end
        elseif node:IsA("Constraint") or node:IsA("Beam") or node:IsA("Trail") then
            for _, property in ipairs({"Attachment0", "Attachment1"}) do
                local attachment = node[property]
                if attachment and not attachment:IsDescendantOf(clone) then node:Destroy(); break end
            end
        end
    end
    local tool
    if clone:IsA("Tool") then tool = clone else tool = Instance.new("Tool"); clone.Parent = tool end
    local handle = tool:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        handle = tool:FindFirstChildWhichIsA("BasePart", true)
        if not handle then tool:Destroy(); return nil end
        handle.Name = "Handle"; handle.Parent = tool
    end
    local links, parts = {}, {}
    for _, part in ipairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false; part.Massless = true
            table.insert(parts, part)
        elseif part:IsA("JointInstance") or part:IsA("WeldConstraint") or (part:IsA("Constraint") and not part:IsA("NoCollisionConstraint")) then
            local a, b
            if part:IsA("JointInstance") or part:IsA("WeldConstraint") then a, b = part.Part0, part.Part1
            else
                a = part.Attachment0 and part.Attachment0:FindFirstAncestorWhichIsA("BasePart")
                b = part.Attachment1 and part.Attachment1:FindFirstAncestorWhichIsA("BasePart")
            end
            if a and b then
                links[a] = links[a] or {}; table.insert(links[a], b)
                links[b] = links[b] or {}; table.insert(links[b], a)
            end
        end
    end
    local connected = {}
    local function visit(part)
        if connected[part] then return end
        connected[part] = true
        for _, neighbor in ipairs(links[part] or {}) do visit(neighbor) end
    end
    visit(handle)
    for _, part in ipairs(parts) do
        if not connected[part] then
            local weld = Instance.new("WeldConstraint"); weld.Part0 = handle; weld.Part1 = part; weld.Parent = part
            visit(part)
        end
    end
    tool.Name = item.name; tool.ToolTip = item.category
    tool.RequiresHandle = true; tool.CanBeDropped = false
    tool.Enabled = item.category == "Fruits"; tool.ManualActivationOnly = item.category ~= "Fruits"
    tool:SetAttribute("BloxCatalogOwned", true); tool:SetAttribute("ItemId", tonumber(item.id))
    return tool
end

function Equipment.fruitMotion(tool, notify, loadAnimation)
    assert(tool:GetAttribute("BloxCatalogOwned"), "Animate only catalog-owned clones")
    loadAnimation = loadAnimation or function(animator, animation) return animator:LoadAnimation(animation) end
    local rigs = {}
    for _, node in ipairs(tool:GetDescendants()) do
        if node:IsA("AnimationController") then
            local idle = node.Parent:FindFirstChild("Idle")
            if idle and idle:IsA("Animation") and idle.AnimationId ~= "" then
                local animator = node:FindFirstChildOfClass("Animator") or Instance.new("Animator",node)
                table.insert(rigs,{animator=animator,animation=idle})
            end
        end
    end
    local motion = {closed=false}
    function motion:setActive(held)
        if self.closed or self.held == held then return end
        -- Animator:LoadAnimation requires Workspace ancestry, so import/preview never starts it.
        if held and not tool:IsDescendantOf(workspace) then return end
        self.held = held
        for _, rig in ipairs(rigs) do
            if held then
                local ok, message = pcall(function()
                    if not rig.track then
                        local track = assert(loadAnimation(rig.animator,rig.animation),"No animation track returned")
                        if self.closed then track:Destroy(); return end
                        rig.track = track
                    end
                    rig.track.Looped = true
                    rig.track.Priority = Enum.AnimationPriority.Idle
                    rig.track:Play(0.1)
                end)
                if not ok then
                    local messageText = "Fruit idle unavailable: " .. tostring(message)
                    warn("[Blox Catalog] " .. messageText)
                    notify(messageText)
                end
            elseif rig.track then
                pcall(rig.track.Stop,rig.track,0.1)
            end
        end
    end
    function motion:close()
        if self.closed then return end
        self.closed = true
        for _, rig in ipairs(rigs) do
            if rig.track then
                pcall(rig.track.Stop,rig.track,0.1)
                pcall(rig.track.Destroy,rig.track)
            end
        end
        table.clear(rigs)
    end
    return motion
end

function Equipment.new(state, player, getSource, notify, onFruitActivated)
    local controller = {bindings = {}, animations = {}}
    function controller:remove(id)
        if self.animations[id] then self.animations[id]:close(); self.animations[id] = nil end
        for _, connection in ipairs(self.bindings[id] or {}) do connection:Disconnect() end
        self.bindings[id] = nil
        local row = state.items[id]
        if row and row.tool then
            if row.tool:GetAttribute("BloxCatalogOwned") then row.tool:Destroy() end
            row.tool = nil
            row.equipped = false
        end
    end
    function controller:store(item)
        local row=state.items[item.id]
        if not row or not row.tool or not row.tool:GetAttribute("BloxCatalogOwned") then return false,"Only local fruit visuals can be stored here" end
        if state.native then
            local ok,message=state.native:sync(item,row.count,false,false)
            if not ok then return false,message end
        end
        self:remove(item.id)
        return true
    end
    function controller:drop(item)
        local row=state.items[item.id]
        local tool=row and row.tool
        local character=player.Character
        local root=character and character:FindFirstChild("HumanoidRootPart")
        local handle=tool and tool:FindFirstChild("Handle")
        if not tool or not tool:GetAttribute("BloxCatalogOwned") or tool.Parent~=character
            or not root or not handle or not handle:IsA("BasePart") then return false,"Hold the local fruit first" end
        tool.Parent=workspace
        handle.CFrame=root.CFrame*CFrame.new(0,0,-4)
        handle.CanCollide=true
        row.equipped=false
        local prompt=handle:FindFirstChild("BloxCatalogPickup")
        if not prompt then
            prompt=Instance.new("ProximityPrompt")
            prompt.Name="BloxCatalogPickup";prompt.ActionText="Pick up visual";prompt.ObjectText=item.name.." (local)"
            prompt.HoldDuration=0;prompt.MaxActivationDistance=10;prompt.RequiresLineOfSight=false
            prompt.Parent=handle
            self.bindings[item.id]=self.bindings[item.id] or {}
            table.insert(self.bindings[item.id],prompt.Triggered:Connect(function(who)
                if who==player and tool.Parent==workspace then
                    local ok,message=self:equip(item)
                    if not ok then notify(tostring(message)) end
                end
            end))
        end
        prompt.Enabled=true
        return true
    end
    function controller:equip(item)
        local row = state.items[item.id]
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local backpack = player:FindFirstChildOfClass("Backpack")
        if not humanoid or humanoid.Health &lt;= 0 or not backpack then return false, "Wait for your character to spawn" end
        local existing = Equipment.findExistingTool(player, item)
        if existing then
            if row and row.tool then
                if state.native then
                    local synced, message = state.native:sync(item, row.count, false, false)
                    if not synced then return false, message end
                end
                self:remove(item.id)
            end
            local ok, message = pcall(humanoid.EquipTool, humanoid, existing)
            if not ok or existing.Parent ~= character then return false, tostring(message or "Existing Tool did not equip") end
            return true, nil, "existing"
        end
        if not row or row.count &lt; 1 then return false, "Add the item first" end
        local tool = row.tool
        if not tool or not tool.Parent then
            self:remove(item.id)
            local source, sourceError = getSource(item)
            tool = Equipment.clone(source, item)
            if not tool then return false, sourceError or ("Missing 3D model for " .. item.name .. "; the catalog only has its metadata/icon") end
            row.tool = tool
        end
        if state.native then
            local synced, err = state.native:sync(item, row.count, true, true)
            if not synced then self:remove(item.id); return false, err end
        end
        tool.Parent = backpack
        tool.Handle.CanCollide=false
        local pickup=tool.Handle:FindFirstChild("BloxCatalogPickup")
        if pickup then pickup.Enabled=false end
        local equipped, err = pcall(humanoid.EquipTool, humanoid, tool)
        if not equipped or tool.Parent ~= character then
            self:remove(item.id)
            if state.native then state.native:sync(item, row.count, false, false) end
            return false, tostring(err or "Character did not equip the local Tool")
        end
        row.equipped = true
        if item.category == "Fruits" and not self.animations[item.id] then
            self.animations[item.id] = Equipment.fruitMotion(tool,notify)
        end
        local motion = self.animations[item.id]
        if motion then motion:setActive(true) end
        if not self.bindings[item.id] then
            local function changed()
                if state.items[item.id] ~= row or row.tool ~= tool then return end
                row.equipped = tool.Parent == player.Character
                if motion then motion:setActive(tool:IsDescendantOf(workspace)) end
                if state.native then
                    local ok, message = state.native:sync(item, row.count, tool.Parent ~= nil, row.equipped)
                    if not ok then notify(message) end
                end
            end
            self.bindings[item.id] = {tool.Equipped:Connect(changed), tool.Unequipped:Connect(changed),
                tool.Destroying:Connect(function() if motion then motion:close() end end)}
            if item.category=="Fruits" and onFruitActivated then
                table.insert(self.bindings[item.id],tool.Activated:Connect(function()
                    if tool.Parent==player.Character then onFruitActivated(item,tool) end
                end))
            end
        end
        return true, nil, "visual"
    end
    function controller:close()
        for id in pairs(state.items) do self:remove(id) end
    end
    return controller
end

return Equipment
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">FruitModels</string><ProtectedString name="Source">local Equipment = require(script.Parent.Equipment)
local FruitModels = {}

function FruitModels.new(fileExists, assetUri, getObjects)
    fileExists = fileExists or (typeof(isfile) == "function" and isfile)
    assetUri = assetUri or (typeof(getcustomasset) == "function" and getcustomasset)
    getObjects = getObjects or function(uri) return game:GetObjects(uri) end
    local root = Instance.new("Folder")
    root.Name = "BloxCatalogLocalFruitModels"
    local cache = {models = {}, loading = {}, closed = false}
    function cache:path(item)
        if self.closed or item.category ~= "Fruits" or not fileExists or not assetUri then return nil end
        for _, name in ipairs({item.storageKey, item.name}) do
            if name and name ~= "" and not name:find("[/\\:]") and not name:find("..",1,true) then
                local path = "codex_fruit_studio/models/" .. name .. ".rbxm"
                local ok, exists = pcall(fileExists,path)
                if ok and exists then return path end
            end
        end
        return nil
    end
    function cache:load(item)
        if self.closed then return nil,"Fruit model cache is closed" end
        if self.models[item.id] then return self.models[item.id] end
        if self.loading[item.id] then return nil,"Fruit model is loading; try again" end
        local path = self:path(item)
        if not path then return nil,"No local model file for " .. item.name end
        self.loading[item.id] = true
        local objects, clean
        local ok, message = pcall(function()
            objects = getObjects(assetUri(path))
            assert(typeof(objects) == "table" and #objects &gt; 0 and #objects &lt;= 20,"Invalid model file contents")
            local source
            for _, object in ipairs(objects) do
                assert(typeof(object) == "Instance","Invalid model object")
                if object:IsA("Tool") or object:IsA("Model") then
                    assert(not source,"Model file contains multiple roots")
                    source = object
                end
            end
            assert(source,"Model file has no Tool or Model")
            local id = source:GetAttribute("ItemId")
            assert(id == nil or tostring(id) == item.id,"Model ItemId does not match catalog")
            assert(#source:GetDescendants() &lt;= 3000,"Fruit model exceeds instance limit")
            -- Imported scripts never enter the DataModel; clone strips code, remotes and tags.
            source.Parent = root
            clean = assert(Equipment.clone(source,item),"Model has no usable BasePart")
            assert(not self.closed,"Fruit model cache was closed while loading")
            clean.Parent = root
            self.models[item.id] = clean
        end)
        if typeof(objects) == "table" then
            for _, object in ipairs(objects) do if typeof(object) == "Instance" then object:Destroy() end end
        end
        self.loading[item.id] = nil
        if not ok then
            if clean then clean:Destroy() end
            return nil,"Local model load failed: " .. tostring(message)
        end
        return clean
    end
    function cache:close()
        self.closed = true
        root:Destroy()
        table.clear(self.models)
    end
    return cache
end

return FruitModels
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Inventory</string><ProtectedString name="Source">local Inventory = {}
function Inventory.new()
    return {items = {}, balance = {beli = 0, fragments = 0}, gifts = {}}
end
function Inventory.add(state, item)
    local row = state.items[item.id]
    local count = (row and row.count or 0) + 1
    if count &gt; 9007199254740991 then return false, "Quantity limit reached" end
    if state.native then
        local ok, err = state.native:sync(item, count, row and row.tool and row.tool.Parent ~= nil, row and row.equipped)
        if not ok then return false, err end
    end
    if row then
        row.count += 1
    else
        state.items[item.id] = {item = item, count = 1}
    end
    return true
end
function Inventory.clear(state, id)
    local removed = {}
    for key, row in pairs(state.items) do
        if id == nil or key == id then
            if state.native then
                local ok, err = state.native:restore(row.item)
                if not ok then
                    if next(removed) then state.lastClear = removed end
                    return false, err
                end
            end
            removed[key] = {item = row.item, count = row.count}
            if state.removeEquipment then state.removeEquipment(key) end
            state.items[key] = nil
        end
    end
    if next(removed) then state.lastClear = removed end
    return true
end
function Inventory.undoClear(state)
    if not state.lastClear then return false end
    for id, row in pairs(state.lastClear) do
        local current = state.items[id]
        if current and current.count &gt; 9007199254740991 - row.count then return false end
    end
    for id, row in pairs(state.lastClear) do
        local current = state.items[id]
        if state.native then
            local ok, err = state.native:sync(row.item, row.count + (current and current.count or 0),
                current and current.tool and current.tool.Parent ~= nil, current and current.equipped)
            if not ok then return false, err end
        end
        if current then current.count += row.count else state.items[id] = row end
        state.lastClear[id] = nil
    end
    state.lastClear = nil
    return true
end
function Inventory.setBalance(state, beli, fragments)
    local function parse(text)
        if not text:match("^%d+$") then return nil end
        local value = tonumber(text)
        return value and value &lt;= 9007199254740991 and value or nil
    end
    local money, shards = parse(beli), parse(fragments)
    if not money or not shards then return false end
    state.balance = {beli = money, fragments = shards}
    return true
end
function Inventory.gift(state, item, username)
    username = username:match("^%s*(.-)%s*$")
    if item.category ~= "Permanent" or #username &lt; 3 or #username &gt; 20 or not username:match("^[A-Za-z0-9_]+$") then return false end
    table.insert(state.gifts, 1, {id = item.id, name = item.name, recipient = username})
    if #state.gifts &gt; 50 then table.remove(state.gifts) end
    return true
end
return Inventory
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">UI</string><ProtectedString name="Source">local Catalog = require(script.Parent.Catalog)
local Inventory = require(script.Parent.Inventory)
local NativeItems = require(script.Parent.NativeItems)
local NativeEquip = require(script.Parent.NativeEquip)
local NativeDialogue = require(script.Parent.NativeDialogue)
local Equipment = require(script.Parent.Equipment)
local FruitModels = require(script.Parent.FruitModels)
local UI = {}

function UI.start()
    local Players = game:GetService("Players")
    local Input = game:GetService("UserInputService")
    local player = assert(Players.LocalPlayer, "Run the catalog on the client")
    local playerGui = player:WaitForChild("PlayerGui")
    local previous = playerGui:FindFirstChild("BloxCatalogSim")
    if previous then previous:Destroy() end
    local colors = {
        background = Color3.fromRGB(15, 17, 23), surface = Color3.fromRGB(34, 37, 49),
        edge = Color3.fromRGB(44, 151, 204), text = Color3.fromRGB(241, 244, 250),
        muted = Color3.fromRGB(169, 181, 197), green = Color3.fromRGB(9, 123, 82),
        available = Color3.fromRGB(25, 54, 43), red = Color3.fromRGB(175, 52, 71),
    }
    local accents = {Fruits = Color3.fromRGB(190, 55, 78), Permanent = Color3.fromRGB(48, 135, 220),
        ["Fruit Skins"] = Color3.fromRGB(175, 58, 162), Premium = Color3.fromRGB(121, 78, 180),
        Swords = Color3.fromRGB(193, 133, 38), Guns = Color3.fromRGB(65, 125, 171), Skills = Color3.fromRGB(52, 142, 126)}
    local state = Inventory.new()
    local tab, category, query, page = "Inventory", "Fruits", "", 1
    local flags = {Visual = true, Balance = true, ["Gift Perm"] = true, Icons = true, Preview3D = true}
    local models, connections, modal, render, refreshModels, updateQuantity = {}, {}, nil, nil, nil, nil
    local fruitModels = FruitModels.new()
    local alive, scanning = true, false
    local showFruitMenu
    local nativeDialogue

    local function make(class, parent, props)
        local object = Instance.new(class)
        for key, value in pairs(props or {}) do object[key] = value end
        object.Parent = parent
        return object
    end
    local function round(object, border)
        make("UICorner", object, {CornerRadius = UDim.new(0, 8)})
        if border then make("UIStroke", object, {Color = colors.edge, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}) end
    end
    local function text(parent, name, value, position, size, fontSize, muted)
        return make("TextLabel", parent, {Name = name, Text = value, Position = position, Size = size,
            BackgroundTransparency = 1, TextColor3 = muted and colors.muted or colors.text,
            Font = Enum.Font.GothamMedium, TextSize = fontSize or 12, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, RichText = false})
    end
    local function button(parent, name, value, position, size, callback, color)
        local object = make("TextButton", parent, {Name = name, Text = value, Position = position, Size = size,
            BackgroundColor3 = color or colors.surface, TextColor3 = colors.text, TextSize = 12,
            Font = Enum.Font.GothamMedium, BorderSizePixel = 0, Selectable = true})
        round(object, true)
        object.Activated:Connect(callback)
        return object
    end
    local function box(parent, name, placeholder, position, size)
        local object = make("TextBox", parent, {Name = name, Text = "", PlaceholderText = placeholder,
            Position = position, Size = size, BackgroundColor3 = colors.surface, BorderSizePixel = 0,
            TextColor3 = colors.text, PlaceholderColor3 = colors.muted, Font = Enum.Font.Gotham,
            TextSize = 13, ClearTextOnFocus = false})
        round(object, true)
        make("UIPadding", object, {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)})
        return object
    end
    local gui = make("ScreenGui", playerGui, {Name = "BloxCatalogSim", ResetOnSpawn = false,
        DisplayOrder = 85, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets})
    gui:SetAttribute("Simulation", true)
    local panel = make("Frame", gui, {Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = colors.background,
        BorderSizePixel = 0, ClipsDescendants = true, Active = true})
    round(panel, true)
    text(panel, "Title", "BLOX CATALOG v8", UDim2.fromOffset(14, 6), UDim2.new(1, -220, 0, 32), 18)
    gui:SetAttribute("Version", 8)
    local drag = make("TextButton", panel, {Name = "DragTitle", BackgroundTransparency = 1, Text = "",
        Size = UDim2.new(1, -202, 0, 42), Selectable = false})
    local openButton
    button(panel, "Hide", "Hide", UDim2.new(1, -122, 0, 4), UDim2.fromOffset(60, 38), function()
        panel.Visible = false; openButton.Visible = true
    end)
    button(panel, "Close", "X", UDim2.new(1, -54, 0, 4), UDim2.fromOffset(44, 38), function() gui:Destroy() end, colors.red)
    openButton = button(gui, "Reopen", "Catalog", UDim2.fromOffset(12, 60), UDim2.fromOffset(100, 44), function()
        panel.Visible = true; openButton.Visible = false
    end)
    openButton.Visible = false
    local nav = make("Frame", panel, {Name = "Navigation", BackgroundTransparency = 1})
    local info = text(panel, "SnapshotInfo", Catalog.count .. " records / local simulation", UDim2.new(), UDim2.new(), 11, true)
    local search = box(panel, "Search", "Search name / ID / rarity", UDim2.new(), UDim2.new())
    local tabs = make("Frame", panel, {Name = "Categories", BackgroundTransparency = 1})
    local content = make("ScrollingFrame", panel, {Name = "Items", BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 5, ScrollBarImageColor3 = colors.edge, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y})
    local footer = make("Frame", panel, {Name = "Footer", BackgroundTransparency = 1})
    local status = text(panel, "Status", "Simulation / Right Shift: show or hide", UDim2.new(), UDim2.new(), 11, true)
    local function tell(value) if alive then status.Text = value end end
    local function sourceFor(item)
        return models[item.id] or (item.physicalId and models[tostring(item.physicalId)]) or fruitModels.models[item.id]
    end
    local equipment = Equipment.new(state, player, function(item)
        local source = sourceFor(item)
        if source then return source end
        if item.category == "Fruits" then return fruitModels:load(item) end
    end, tell, function(item,tool) if showFruitMenu then showFruitMenu(item,tool) end end)
    state.removeEquipment = function(id) equipment:remove(id) end
    local function equip(item)
        local ok, err, mode = equipment:equip(item)
        tell(ok and ((mode == "existing" and "Equipped existing Tool: " or "Equipped local visual: ") .. item.name) or ("Equip unavailable: " .. tostring(err)))
        if not ok then warn("[Blox Catalog] Equip unavailable: " .. tostring(err)) end
        return ok, err, mode
    end
    local nativeEquip=NativeEquip.new(playerGui,state,equip)
    task.spawn(function()
        while alive do nativeEquip:refresh();task.wait(0.2) end
    end)
    local function useVisual(item)
        if not Equipment.findExistingTool(player, item) and not state.items[item.id] then
            if not sourceFor(item) then
                tell("Missing 3D model for " .. item.name .. ". View shows its icon; no Tool is available to equip.")
                return
            end
            local ok, err = Inventory.add(state, item)
            if not ok then tell("Add failed: " .. tostring(err)); return end
            updateQuantity()
        end
        local ok, _, mode = equip(item)
        if ok then
            state.visualId = item.id
            if state.items[item.id] then state.items[item.id].visual = mode == "visual" end
            gui:SetAttribute("VisualItemId", item.id)
        end
    end
    local function closeModal()
        if nativeDialogue then nativeDialogue:dismiss() end
        local current=modal;modal=nil
        if current then current:Destroy() end
    end
    local function openModal(title)
        closeModal()
        modal = make("Frame", gui, {Name = "Modal", Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(), BackgroundTransparency = 0.25, ZIndex = 20, Active = true})
        local body = make("Frame", modal, {Name = "Body", AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -40, 1, -40),
            BackgroundColor3 = colors.background, ZIndex = 21, BorderSizePixel = 0})
        make("UISizeConstraint", body, {MaxSize = Vector2.new(480, 500)})
        round(body, true)
        text(body, "Title", title, UDim2.fromOffset(16, 8), UDim2.new(1, -84, 0, 40), 15)
        button(body, "CloseModal", "X", UDim2.new(1, -56, 0, 8), UDim2.fromOffset(40, 40), closeModal)
        local scroll = make("ScrollingFrame", body, {Name = "Contents", Position = UDim2.fromOffset(12, 60),
            Size = UDim2.new(1, -24, 1, -72), BackgroundTransparency = 1, BorderSizePixel = 0,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4})
        return scroll
    end
    showFruitMenu = function(item,tool)
        if nativeDialogue and nativeDialogue.running then return end
        closeModal()
        local function menuError(reason)
            local message="Fruit menu unavailable: "..tostring(reason)
            tell(message);warn("[Blox Catalog] "..message)
            if typeof(writefile)=="function" then pcall(writefile,"blox-catalog-menu-error.txt",message) end
        end
        if not nativeDialogue then
            local connected,value=pcall(NativeDialogue.connect)
            if not connected then menuError(value);return end
            nativeDialogue=value
        end
        if not alive then nativeDialogue:close();return end
        tell("Local visual menu / Drop and Store affect this client only.")
        local wasEnabled=gui.Enabled
        gui.Enabled=false
        local called,ok,message=pcall(nativeDialogue.show,nativeDialogue,tool,{
            Eat=function()tell("Eating requires a real server-owned fruit; this visual grants no abilities.")end,
            Drop=function()
                local success,err=equipment:drop(item)
                tell(success and "Dropped local visual. Use its pickup prompt to hold it again." or tostring(err))
            end,
            Store=function()
                local success,err=equipment:store(item)
                if success then updateQuantity();render() end
                tell(success and "Local fruit returned to stock." or tostring(err))
            end,
        })
        if alive then
            gui.Enabled=wasEnabled
            if not called or not ok then menuError(called and message or ok) end
        end
    end
    local function image(parent, item, position, size)
        local label = make("ImageLabel", parent, {Name = "Icon", Image = item.icon, BackgroundTransparency = 1,
            Position = position, Size = size, ScaleType = Enum.ScaleType.Fit})
        if item.iconRectOffset then label.ImageRectOffset = Vector2.new(table.unpack(item.iconRectOffset)) end
        if item.iconRectSize then label.ImageRectSize = Vector2.new(table.unpack(item.iconRectSize)) end
        if item.icon == "" then
            text(parent, "MissingIcon", "?", position, size, 28, true)
        end
        return label
    end
    local function modelPreview(parent, item)
        local source = sourceFor(item)
        if not source or not source.Parent then return false end
        local ok, clone = pcall(function() return source:Clone() end)
        if not ok or not clone then return false end
        for _, node in ipairs(clone:GetDescendants()) do
            if node:IsA("LuaSourceContainer") or node:IsA("Sound") then node:Destroy()
            elseif node:IsA("BasePart") then node.Anchored = true; node.CanCollide = false end
        end
        if not clone:FindFirstChildWhichIsA("BasePart", true) then clone:Destroy(); return false end
        local viewport = make("ViewportFrame", parent, {Name = "ModelPreview", BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 180), Ambient = Color3.fromRGB(200, 200, 200)})
        local world = make("WorldModel", viewport)
        local model = make("Model", world)
        clone.Parent = model
        local center, size = model:GetBoundingBox()
        local camera = make("Camera", viewport, {FieldOfView = 40})
        camera.CFrame = CFrame.lookAt(center.Position + Vector3.new(1, 0.6, 1.6).Unit * math.max(2, size.Magnitude * 1.7), center.Position)
        viewport.CurrentCamera = camera
        return true
    end
    local function preview(item)
        local body = openModal(item.title ~= "" and item.title or item.name)
        local hasModel = flags.Preview3D and modelPreview(body, item)
        if not hasModel then image(body, item, UDim2.new(0.5, -80, 0, 0), UDim2.fromOffset(160, 160)) end
        local details = item.rarity .. " / Item ID " .. item.id .. "\n" .. item.idType .. " / " .. item.category
        details ..= hasModel and "\nLocal model preview" or "\nIcon preview"
        text(body, "Details", details, UDim2.fromOffset(4, 186), UDim2.new(1, -8, 0, 80), 13)
        text(body, "Description", item.description, UDim2.fromOffset(4, 274), UDim2.new(1, -8, 0, 100), 12, true)
        tell("Viewing: " .. item.name)
    end
    local function settings()
        local body = openModal("Utilities")
        for index, key in ipairs({"Visual", "Balance", "Gift Perm", "Icons", "Preview3D"}) do
            local control
            control = button(body, "Toggle" .. key, key .. ": " .. (flags[key] and "ON" or "OFF"),
                UDim2.fromOffset(4, (index - 1) * 52), UDim2.new(1, -8, 0, 44), function()
                    flags[key] = not flags[key]
                    control.Text = key .. ": " .. (flags[key] and "ON" or "OFF")
                    gui:SetAttribute("Enabled" .. key:gsub(" ", ""), flags[key])
                    if tab == key and not flags[key] then tab = "Inventory"; category = "Fruits" end
                    render()
                end)
        end
    end
    button(panel, "Settings", "Tools", UDim2.new(1, -194, 0, 4), UDim2.fromOffset(64, 38), settings)
    local function showGift(item)
        local body = openModal("Gift Perm simulation")
        text(body, "GiftItem", item.name .. " / ID " .. item.id, UDim2.fromOffset(4, 4), UDim2.new(1, -8, 0, 50), 15)
        local recipient = box(body, "Recipient", "Recipient username", UDim2.fromOffset(4, 66), UDim2.new(1, -8, 0, 44))
        button(body, "RecordGift", "Record simulated gift", UDim2.fromOffset(4, 126), UDim2.new(1, -8, 0, 44), function()
            if Inventory.gift(state, item, recipient.Text) then
                gui:SetAttribute("GiftCount", #state.gifts)
                closeModal(); tell("Simulated gift recorded for " .. state.gifts[1].recipient)
            else tell("Use a username of 3–20 letters, digits or underscores.") end
        end, colors.green)
        text(body, "Scope", "Gifts are recorded inside this simulator.", UDim2.fromOffset(4, 190), UDim2.new(1, -8, 0, 55), 12, true)
    end
    updateQuantity = function()
        local count = 0
        for _, row in pairs(state.items) do count += row.count end
        gui:SetAttribute("LocalQuantity", count)
    end

    render = function()
        if not alive then return end
        nav:ClearAllChildren(); tabs:ClearAllChildren(); content:ClearAllChildren(); footer:ClearAllChildren()
        content.CanvasPosition = Vector2.zero
        gui:SetAttribute("Tab", tab); gui:SetAttribute("Category", category)
        local navigation = {"Inventory", "Added"}
        for _, key in ipairs({"Visual", "Balance", "Gift Perm"}) do
            if flags[key] then table.insert(navigation, key) end
        end
        for index, key in ipairs(navigation) do
            button(nav, key, key, UDim2.fromScale((index - 1) / #navigation, 0), UDim2.new(1 / #navigation, -4, 1, 0), function()
                tab = key; category = key == "Visual" and "Swords" or key == "Gift Perm" and "Permanent" or "Fruits"
                page = 1; query = ""; search.Text = ""; render()
            end, key == tab and colors.edge or nil)
        end
        search.Visible = tab ~= "Balance"
        if tab == "Balance" then
            text(content, "BalanceScope", "Balance simulation", UDim2.fromOffset(4, 0), UDim2.new(1, -8, 0, 26), 15)
            text(content, "BeliLabel", "Beli", UDim2.fromOffset(4, 36), UDim2.new(1, -8, 0, 20), 12, true)
            local beli = box(content, "Beli", "Beli", UDim2.fromOffset(4, 60), UDim2.new(1, -8, 0, 44))
            text(content, "FragmentsLabel", "Fragments", UDim2.fromOffset(4, 116), UDim2.new(1, -8, 0, 20), 12, true)
            local fragments = box(content, "Fragments", "Fragments", UDim2.fromOffset(4, 140), UDim2.new(1, -8, 0, 44))
            beli.Text, fragments.Text = tostring(state.balance.beli), tostring(state.balance.fragments)
            button(content, "SaveBalance", "Save local balance", UDim2.fromOffset(4, 204), UDim2.new(1, -8, 0, 44), function()
                if Inventory.setBalance(state, beli.Text, fragments.Text) then
                    gui:SetAttribute("Beli", state.balance.beli); gui:SetAttribute("Fragments", state.balance.fragments)
                    tell("Simulation balance saved.")
                else tell("Enter whole numbers from 0 to 9007199254740991.") end
            end, colors.green)
            button(content, "ResetBalance", "Reset balance", UDim2.fromOffset(4, 262), UDim2.new(1, -8, 0, 44), function()
                Inventory.setBalance(state, "0", "0"); gui:SetAttribute("Beli", 0); gui:SetAttribute("Fragments", 0); render()
            end)
            return
        end
        local categoryTabs = tab == "Inventory" and {"Fruits", "Permanent", "Fruit Skins", "Premium"}
            or tab == "Visual" and {"Swords", "Guns", "Skills"} or {}
        for index, key in ipairs(categoryTabs) do
            button(tabs, key, key, UDim2.fromScale((index - 1) / #categoryTabs, 0), UDim2.new(1 / #categoryTabs, -4, 1, 0), function()
                category = key; page = 1; render()
            end, category == key and accents[key] or nil)
        end
        local rows = {}
        if tab == "Added" then
            for _, row in pairs(state.items) do
                if Catalog.matches(row.item, query) then table.insert(rows, row.item) end
            end
            table.sort(rows, function(a, b) return a.name:lower() &lt; b.name:lower() end)
            button(tabs, "ClearAll", "Clear Whole Inventory", UDim2.new(), UDim2.new(0.63, -4, 1, 0), function()
                local ok, err = Inventory.clear(state)
                updateQuantity(); render(); tell(ok and "Local inventory cleared. Undo Clear is available." or ("Clear failed: " .. tostring(err)))
            end, colors.red)
            button(tabs, "UndoClear", "Undo Clear", UDim2.fromScale(0.64, 0), UDim2.new(0.36, -4, 1, 0), function()
                local ok, err = Inventory.undoClear(state); updateQuantity(); render()
                tell(ok and "Last cleared batch restored." or tostring(err or "Nothing to undo."))
            end)
        else
            rows = Catalog.search(query, category)
        end
        gui:SetAttribute("ResultCount", #rows)
        -- shortcut: 30 cards per page bounds UI instances; virtualize if larger pages are needed.
        local pages = math.max(1, math.ceil(#rows / 30))
        page = math.clamp(page, 1, pages)
        button(footer, "Previous", "&lt;", UDim2.new(), UDim2.new(0.12, 0, 1, 0), function() page -= 1; render() end)
        text(footer, "Page", page .. " / " .. pages .. " • " .. #rows .. " items", UDim2.fromScale(0.14, 0), UDim2.new(0.37, 0, 1, 0), 11, true)
        button(footer, "Next", "&gt;", UDim2.fromScale(0.52, 0), UDim2.new(0.12, 0, 1, 0), function() page += 1; render() end)
        if tab == "Gift Perm" then
            button(footer, "History", "History", UDim2.fromScale(0.67, 0), UDim2.new(0.33, 0, 1, 0), function()
                local body = openModal("Simulated gift history")
                local lines = {}
                for _, gift in ipairs(state.gifts) do table.insert(lines, gift.name .. " → " .. gift.recipient) end
                text(body, "History", #lines &gt; 0 and table.concat(lines, "\n") or "No simulated gifts.", UDim2.fromOffset(4, 0), UDim2.new(1, -8, 0, math.max(60, #lines * 44)), 13)
            end)
        elseif tab == "Visual" then
            button(footer, "RestoreVisual", "Restore visuals", UDim2.fromScale(0.67, 0), UDim2.new(0.33, 0, 1, 0), function()
                for id, row in pairs(state.items) do
                    if row.visual then
                        if state.native then
                            local ok, err = state.native:sync(row.item, row.count, false, false)
                            if not ok then tell("Restore failed: " .. tostring(err)); return end
                        end
                        equipment:remove(id); row.visual = nil
                    end
                end
                state.visualId = nil; gui:SetAttribute("VisualItemId", nil); closeModal(); tell("Visual selection cleared.")
            end)
        else
            button(footer, "Rescan", "Rescan", UDim2.fromScale(0.67, 0), UDim2.new(0.33, 0, 1, 0), refreshModels)
        end
        local columns = panel.AbsoluteSize.X &lt; 480 and 1 or 2
        make("UIGridLayout", content, {CellSize = UDim2.new(1 / columns, -8, 0, 132),
            CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder})
        if #rows == 0 then
            text(content, "Empty", "No matching items", UDim2.new(), UDim2.new(1, -8, 0, 116), 15, true)
        end
        for index = (page - 1) * 30 + 1, math.min(page * 30, #rows) do
            local item = rows[index]
            local source = sourceFor(item)
            local stock = state.items[item.id]
            local available = (source and source.Parent and source:FindFirstChildWhichIsA("BasePart", true))
                or Equipment.findExistingTool(player, item) or (stock and stock.tool and stock.tool.Parent) or fruitModels:path(item)
            local card = make("Frame", content, {Name = "Item_" .. item.id, LayoutOrder = index,
                BackgroundColor3 = available and colors.available or colors.surface, BorderSizePixel = 0})
            card:SetAttribute("ItemId", item.id); round(card, false)
            if flags.Icons then image(card, item, UDim2.fromOffset(8, 8), UDim2.fromOffset(58, 58)) end
            local left = flags.Icons and 74 or 10
            text(card, "Name", item.title ~= "" and item.title or item.name, UDim2.fromOffset(left, 6), UDim2.new(1, -left - 8, 0, 50), 12)
            text(card, "Metadata", item.rarity .. " • " .. item.id, UDim2.fromOffset(10, 64), UDim2.new(1, -20, 0, 16), 10, true)
            if tab == "Added" then
                text(card, "Count", "×" .. state.items[item.id].count, UDim2.fromOffset(10, 88), UDim2.new(0.4, 0, 0, 22), 12)
                button(card, "Equip", available and "Equip" or "No model", UDim2.new(1, -168, 1, -48), UDim2.fromOffset(76, 42), function() equip(item) end, available and colors.green or colors.surface)
                button(card, "Clear", "Clear", UDim2.new(1, -84, 1, -48), UDim2.fromOffset(76, 42), function()
                    local ok, err = Inventory.clear(state, item.id)
                    updateQuantity(); render(); tell(ok and "Item cleared from the local inventory." or ("Clear failed: " .. tostring(err)))
                end, colors.red)
            else
                button(card, "Details", "View", UDim2.fromOffset(8, 84), UDim2.fromOffset(60, 42), function() preview(item) end)
                button(card, "Action", tab == "Visual" and (available and "Equip" or "No model") or tab == "Gift Perm" and "Gift" or "+ Add",
                    UDim2.new(1, -94, 1, -48), UDim2.fromOffset(86, 42), function()
                        if tab == "Visual" then useVisual(item)
                        elseif tab == "Gift Perm" then showGift(item)
                        else
                            local ok, err = Inventory.add(state, item)
                            if ok then
                                updateQuantity()
                                tell((state.native and "Added to Items locally: " or "Added to panel only / Items offline: ") .. item.name)
                            else
                                tell("Add failed: " .. tostring(err))
                                warn("[Blox Catalog] " .. status.Text)
                                if state.native and state.native.lastFailure and typeof(writefile) == "function" then
                                    local failure = {schemaVersion = 1, placeId = game.PlaceId, placeVersion = game.PlaceVersion, write = state.native.lastFailure}
                                    pcall(writefile, "blox-catalog-native-error-" .. game.PlaceId .. ".json", game:GetService("HttpService"):JSONEncode(failure))
                                end
                            end
                        end
                    end, tab == "Visual" and not available and colors.surface or colors.green)
            end
        end
    end

    refreshModels = function()
        if scanning or not alive then return end
        scanning = true
        task.spawn(function()
            if not state.native then
                local linked, bridge = pcall(NativeItems.connect, equip)
                if linked then
                    -- The GUI may close while cached imports are yielding.
                    if not alive then bridge:close(); return end
                    local synced, syncError = true, nil
                    for _, row in pairs(state.items) do
                        synced, syncError = bridge:sync(row.item, row.count, row.tool and row.tool.Parent ~= nil, row.equipped)
                        if not synced then break end
                    end
                    if synced then
                        state.native = bridge; state.nativeError = nil
                        print("[Blox Catalog] Native Items linked locally")
                    else
                        local cleaned = bridge:close()
                        if not cleaned then state.native = bridge end
                        state.nativeError = tostring(syncError)
                    end
                else state.nativeError = tostring(bridge) end
            end
            local storage = game:GetService("ReplicatedStorage")
            local roots = {}
            for _, root in pairs({storage:FindFirstChild("HybridDownloadedFruitTemplates"),
                player:FindFirstChild("Backpack"), player.Character, playerGui:FindFirstChild("WeaponAssetCache")}) do
                table.insert(roots, root)
            end
            for _, node in ipairs(workspace:GetChildren()) do
                if node:IsA("Tool") then table.insert(roots, node) end
            end
            local found, visited = {}, 0
            for _, root in ipairs(roots) do
                local queue, head = {root}, 1
                while queue[head] and visited &lt; 3000 and alive do
                    local node = queue[head]; head += 1; visited += 1
                    if not node:GetAttribute("BloxCatalogOwned") and (node:IsA("Tool") or node:IsA("Model")) then
                        local id = tostring(node:GetAttribute("ItemId") or "")
                        if id == "" and node:IsA("Tool") then id = Catalog.byToolName[node.Name] or "" end
                        if Catalog.byId[id] then found[id] = node end
                    end
                    for _, child in ipairs(node:GetChildren()) do
                        if #queue &gt;= 3000 then break end
                        if not node:GetAttribute("BloxCatalogOwned") and not child:IsA("LuaSourceContainer") and not child:IsA("BasePart") then table.insert(queue, child) end
                    end
                    if visited % 100 == 0 then task.wait() end
                end
            end
            scanning = false
            if not alive then return end
            models = found
            info.Text = Catalog.count .. " records / " .. (state.native and "Items linked locally" or "Items offline / panel only")
            info:SetAttribute("ItemsLinked", state.native ~= nil)
            if tab ~= "Balance" then render() end
            local modelCount = 0
            for _ in pairs(found) do modelCount += 1 end
            tell(state.nativeError and ("Items offline: " .. state.nativeError) or ("Items linked locally / " .. modelCount .. " models available"))
            print("[Blox Catalog] " .. status.Text)
        end)
    end
    table.insert(connections, search:GetPropertyChangedSignal("Text"):Connect(function()
        query = search.Text; page = 1; render()
    end))
    table.insert(connections, player.CharacterAdded:Connect(function()
        equipment:close()
        for _, row in pairs(state.items) do
            if state.native then
                local ok, err = state.native:sync(row.item, row.count, false, false)
                if not ok then tell(tostring(err)) end
            end
        end
        refreshModels()
    end))
    table.insert(connections, Input.InputBegan:Connect(function(key, processed)
        if processed or Input:GetFocusedTextBox() then return end
        if key.KeyCode == Enum.KeyCode.Escape then closeModal()
        elseif key.KeyCode == Enum.KeyCode.RightShift then panel.Visible = not panel.Visible; openButton.Visible = not panel.Visible
        elseif key.KeyCode == Enum.KeyCode.F6 then refreshModels() end
    end))
    local dragging, origin, start, moved
    local function clamp(position)
        local bounds, size = gui.AbsoluteSize, panel.AbsoluteSize
        return UDim2.fromOffset(math.clamp(position.X.Scale * bounds.X + position.X.Offset, size.X / 2, math.max(size.X / 2, bounds.X - size.X / 2)),
            math.clamp(position.Y.Scale * bounds.Y + position.Y.Offset, size.Y / 2, math.max(size.Y / 2, bounds.Y - size.Y / 2)))
    end
    table.insert(connections, drag.InputBegan:Connect(function(key)
        if key.UserInputType == Enum.UserInputType.MouseButton1 or key.UserInputType == Enum.UserInputType.Touch then
            dragging, origin, start = key, key.Position, panel.Position
        end
    end))
    table.insert(connections, Input.InputChanged:Connect(function(key)
        if dragging and (key == dragging or key.UserInputType == Enum.UserInputType.MouseMovement and dragging.UserInputType == Enum.UserInputType.MouseButton1) then
            local delta = key.Position - origin; moved = true
            panel.Position = clamp(start + UDim2.fromOffset(delta.X, delta.Y))
        end
    end))
    table.insert(connections, Input.InputEnded:Connect(function(key)
        if key == dragging then dragging = nil end
    end))
    local function resize()
        local size = gui.AbsoluteSize
        local width = math.min(620, math.max(200, size.X - 20))
        panel.Size = UDim2.fromOffset(width, math.min(760, math.max(260, size.Y - 20)))
        local compact = size.Y &lt; 540
        nav.Position = UDim2.fromOffset(12, 48); nav.Size = UDim2.new(1, -24, 0, compact and 30 or 38)
        info.Visible = not compact; info.Position = UDim2.fromOffset(14, 92); info.Size = UDim2.new(1, -28, 0, 18)
        search.Position = UDim2.fromOffset(12, compact and 86 or 116); search.Size = UDim2.new(1, -24, 0, compact and 32 or 40)
        tabs.Position = UDim2.fromOffset(12, compact and 124 or 164); tabs.Size = UDim2.new(1, -24, 0, compact and 32 or 38)
        content.Position = UDim2.fromOffset(12, compact and 164 or 210); content.Size = UDim2.new(1, -24, 1, compact and -224 or -274)
        footer.Position = UDim2.new(0, 12, 1, -58); footer.Size = UDim2.new(1, -24, 0, 34)
        status.Position = UDim2.new(0, 14, 1, -22); status.Size = UDim2.new(1, -28, 0, 20)
        panel.Position = moved and clamp(panel.Position) or UDim2.fromScale(0.5,0.5)
        render()
    end
    table.insert(connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize))
    gui.Destroying:Connect(function()
        alive = false
        equipment:close()
        fruitModels:close()
        nativeEquip:close()
        if nativeDialogue then nativeDialogue:close() end
        if state.native then
            local called, ok, err = pcall(state.native.close, state.native)
            if not called or not ok then warn("[Blox Catalog] Native restore failed: " .. tostring(called and err or ok)) end
        end
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(models)
    end)
    resize(); refreshModels()
    return gui
end

return UI
</ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">Main</string><ProtectedString name="Source">require(script.Parent.UI).start()
</ProtectedString></Properties></Item></Item></roblox>